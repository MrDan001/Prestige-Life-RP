@@ -0,0 +1,73 @@
+// PATH: app/api/admin/demo-complaints/route.ts
+import { NextResponse } from "next/server";
+import { z } from "zod";
+import { db } from "@/lib/db";
+import { requireAdmin } from "@/lib/auth";
+import { audit } from "@/lib/audit";
+import { evidenceItem } from "@/lib/evidence";
+
+const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-");
+
+/** Owner only: the demo comps created from the Comp screen, newest first. */
+export async function GET() {
+  const a = await requireAdmin();
+  if (a.error) return a.error;
+  if (a.actor.kind !== "OWNER") return NextResponse.json({ error: "Only the owner can use this" }, { status: 403 });
+
+  const rows = await db.complaint.findMany({
+    where: { player: { gameId: { startsWith: "demo-p-" } } },
+    orderBy: { createdAt: "desc" },
+    take: 20,
+    include: { category: { select: { name: true } }, player: { select: { username: true } }, accusedAdmin: { select: { name: true } } },
+  });
+  return NextResponse.json(
+    rows.map((r) => ({
+      id: r.id, category: r.category.name, complainant: r.player.username, accused: r.accusedAdmin?.name ?? r.accusedName ?? "none",
+      status: r.status, minLevel: r.minLevel, createdAt: r.createdAt,
+    }))
+  );
+}
+
+const schema = z.object({
+  categoryId: z.string().min(1),
+  complainant: z.string().min(2).max(64),
+  accusedName: z.string().max(64).optional(), // a normal player
+  accusedStaffId: z.string().min(1).optional(), // or one of your staff, to test the staff rules
+  message: z.string().min(5).max(2000),
+  minLevel: z.coerce.number().int().min(3).max(6).nullable().optional(), // empty = use the category's level
+  evidence: z.array(evidenceItem).max(10).default([]),
+});
+
+/** Owner only: create a demo comp by hand. It appears on the Complaints screen like a real one. */
+export async function POST(req: Request) {
+  const a = await requireAdmin();
+  if (a.error) return a.error;
+  if (a.actor.kind !== "OWNER") return NextResponse.json({ error: "Only the owner can create demo comps" }, { status: 403 });
+
+  const parsed = schema.safeParse(await req.json().catch(() => null));
+  if (!parsed.success) return NextResponse.json({ error: "Check the form: category, complainant and description are required", details: parsed.error.flatten() }, { status: 400 });
+  const d = parsed.data;
+
+  if (!(await db.category.findUnique({ where: { id: d.categoryId } }))) return NextResponse.json({ error: "Category not found" }, { status: 404 });
+  const staff = d.accusedStaffId ? await db.admin.findUnique({ where: { id: d.accusedStaffId }, select: { id: true, name: true, gameId: true } }) : null;
+  if (d.accusedStaffId && !staff) return NextResponse.json({ error: "That staff member was not found" }, { status: 404 });
+
+  const gameId = `demo-p-${slug(d.complainant)}`;
+  const player = await db.player.upsert({ where: { gameId }, update: { username: d.complainant }, create: { gameId, username: d.complainant } });
+  const accusedName = staff?.name ?? (d.accusedName?.trim() || undefined);
+
+  const c = await db.complaint.create({
+    data: {
+      playerId: player.id,
+      categoryId: d.categoryId,
+      message: d.message,
+      minLevel: d.minLevel ?? null,
+      accusedName,
+      accusedGameId: staff?.gameId ?? (accusedName ? `demo-t-${slug(accusedName)}` : undefined),
+      accusedAdminId: staff?.id,
+      evidence: { create: d.evidence.map((e) => ({ kind: e.kind, url: e.url, text: e.text, caption: e.caption })) },
+    },
+  });
+  await audit(a.actor.id, "DEMO_COMPLAINT_CREATE", c.id, `${d.complainant} vs ${accusedName ?? "nobody"}${d.minLevel ? `, level ${d.minLevel}+` : ""}`);
+  return NextResponse.json({ id: c.id }, { status: 201 });
+}
