+// PATH: app/admin/comp/page.tsx
+"use client";
+import { useCallback, useEffect, useState } from "react";
+
+type Cat = { id: string; name: string; active: boolean };
+type Staff = { id: string; name: string; title: string };
+type Ev = { kind: "IMAGE" | "VIDEO" | "LINK" | "TEXT"; url?: string; text?: string; caption?: string };
+type Demo = { id: string; category: string; complainant: string; accused: string; status: string; minLevel: number | null; createdAt: string };
+
+const muted = "#a7a2c2";
+const panel: React.CSSProperties = { border: "1px solid #2a2540", background: "#13111f", borderRadius: 12, padding: 16 };
+const field: React.CSSProperties = { display: "grid", gap: 4 };
+const EV_LABEL: Record<Ev["kind"], string> = { IMAGE: "Screenshot link", VIDEO: "Video link", LINK: "Other link", TEXT: "Chat log text" };
+
+export default function CompPage() {
+  const [cats, setCats] = useState<Cat[]>([]);
+  const [staff, setStaff] = useState<Staff[]>([]);
+  const [recent, setRecent] = useState<Demo[]>([]);
+  const [categoryId, setCategoryId] = useState("");
+  const [complainant, setComplainant] = useState("");
+  const [accusedName, setAccusedName] = useState("");
+  const [accusedStaffId, setAccusedStaffId] = useState("");
+  const [message, setMessage] = useState("");
+  const [level, setLevel] = useState("");
+  const [evidence, setEvidence] = useState<Ev[]>([]);
+  const [evKind, setEvKind] = useState<Ev["kind"]>("IMAGE");
+  const [evValue, setEvValue] = useState("");
+  const [evCaption, setEvCaption] = useState("");
+  const [msg, setMsg] = useState("");
+
+  const load = useCallback(async () => {
+    const [c, s, r] = await Promise.all([fetch("/api/admin/categories"), fetch("/api/admin/admins"), fetch("/api/admin/demo-complaints")]);
+    if (c.ok) setCats((await c.json()).filter((x: Cat) => x.active));
+    if (s.ok) setStaff(await s.json());
+    if (r.ok) setRecent(await r.json());
+  }, []);
+
+  useEffect(() => {
+    fetch("/api/admin/me").then(async r => {
+      if (!r.ok) { window.location.href = "/auth"; return; }
+      if ((await r.json()).kind !== "OWNER") { window.location.href = "/admin"; return; }
+      load();
+    });
+  }, [load]);
+
+  function addEvidence() {
+    const v = evValue.trim();
+    if (!v) return;
+    if (evKind !== "TEXT" && !v.startsWith("https://")) { setMsg("Links must start with https://"); return; }
+    setEvidence([...evidence, evKind === "TEXT" ? { kind: evKind, text: v, caption: evCaption.trim() || undefined } : { kind: evKind, url: v, caption: evCaption.trim() || undefined }]);
+    setEvValue(""); setEvCaption(""); setMsg("");
+  }
+
+  async function create(e: React.FormEvent) {
+    e.preventDefault();
+    const res = await fetch("/api/admin/demo-complaints", {
+      method: "POST", headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        categoryId, complainant, message, evidence,
+        accusedName: accusedStaffId ? undefined : accusedName.trim() || undefined,
+        accusedStaffId: accusedStaffId || undefined,
+        minLevel: level ? Number(level) : null,
+      }),
+    });
+    const d = await res.json().catch(() => ({}));
+    if (res.ok) {
+      setMsg("Demo comp created. Open Complaints to see it.");
+      setComplainant(""); setAccusedName(""); setAccusedStaffId(""); setMessage(""); setLevel(""); setEvidence([]);
+      load();
+    } else setMsg(d.error ?? "Could not create the comp");
+  }
+
+  return (
+    <main style={{ maxWidth: 800, margin: "0 auto", padding: 24, display: "grid", gap: 20 }}>
+      <header>
+        <h1>Comp</h1>
+        <p style={{ color: muted, margin: "4px 0 0" }}>Write a demo comp by hand. It shows up on the Complaints screen for the admins, who can answer or close it depending on the level you set.</p>
+      </header>
+
+      <form onSubmit={create} style={{ ...panel, display: "grid", gap: 14 }}>
+        <label style={field}>Category
+          <select value={categoryId} onChange={e => setCategoryId(e.target.value)} required>
+            <option value="">Choose a category…</option>
+            {cats.map(c => <option key={c.id} value={c.id}>{c.name}</option>)}
+          </select>
+        </label>
+        <label style={field}>Complaint from (player name)
+          <input value={complainant} onChange={e => setComplainant(e.target.value)} placeholder="e.g. Tunde_K" required minLength={2} />
+        </label>
+        <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
+          <label style={{ ...field, flex: 1, minWidth: 200 }}>Complaint about (player name)
+            <input value={accusedName} onChange={e => setAccusedName(e.target.value)} placeholder="e.g. BadGuy_01" disabled={!!accusedStaffId} />
+          </label>
+          <label style={{ ...field, flex: 1, minWidth: 200 }}>Or pick a staff member
+            <select value={accusedStaffId} onChange={e => setAccusedStaffId(e.target.value)}>
+              <option value="">Not a staff member</option>
+              {staff.map(s => <option key={s.id} value={s.id}>{s.name} · {s.title}</option>)}
+            </select>
+          </label>
+        </div>
+        <label style={field}>Description
+          <textarea value={message} onChange={e => setMessage(e.target.value)} rows={4} placeholder="What happened?" required minLength={5} />
+        </label>
+        <label style={field}>Level that can answer it
+          <select value={level} onChange={e => setLevel(e.target.value)}>
+            <option value="">Use the category&apos;s level</option>
+            {[3, 4, 5, 6].map(l => <option key={l} value={l}>Level {l} and above</option>)}
+          </select>
+          <small style={{ color: muted }}>Admins below this level can see the comp but not answer it. A comp against staff still follows the staff rules, and the owner, tech and developers can always answer.</small>
+        </label>
+
+        <div style={{ display: "grid", gap: 8 }}>
+          <strong>Evidence <span style={{ color: muted, fontWeight: 400 }}>· optional, up to 10</span></strong>
+          {evidence.map((ev, i) => (
+            <div key={i} style={{ display: "flex", gap: 10, alignItems: "center", border: "1px solid #2a2540", borderRadius: 10, padding: "8px 12px" }}>
+              <span style={{ flex: 1, minWidth: 0, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{EV_LABEL[ev.kind]}: {ev.url ?? ev.text}</span>
+              <button type="button" onClick={() => setEvidence(evidence.filter((_, j) => j !== i))}>Remove</button>
+            </div>
+          ))}
+          <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
+            <select value={evKind} onChange={e => setEvKind(e.target.value as Ev["kind"])} aria-label="Evidence type">
+              {(Object.keys(EV_LABEL) as Ev["kind"][]).map(k => <option key={k} value={k}>{EV_LABEL[k]}</option>)}
+            </select>
+            <input value={evValue} onChange={e => setEvValue(e.target.value)} placeholder={evKind === "TEXT" ? "Paste the chat log" : "https://…"} style={{ flex: 2, minWidth: 180 }} aria-label="Evidence link or text" />
+            <input value={evCaption} onChange={e => setEvCaption(e.target.value)} placeholder="Caption (optional)" style={{ flex: 1, minWidth: 120 }} aria-label="Evidence caption" />
+            <button type="button" onClick={addEvidence}>Add</button>
+          </div>
+        </div>
+
+        <div style={{ display: "flex", gap: 10, alignItems: "center", flexWrap: "wrap" }}>
+          <button className="primary">Create comp</button>
+          {msg && <span role="status">{msg}</span>}
+        </div>
+      </form>
+
+      <section style={panel}>
+        <strong>Demo comps you created</strong>
+        {recent.length === 0 && <p style={{ color: muted, margin: "6px 0 0" }}>None yet.</p>}
+        {recent.map(r => (
+          <div key={r.id} style={{ borderTop: "1px solid #2a2540", marginTop: 10, paddingTop: 10 }}>
+            <strong>{r.category}</strong> <span style={{ color: muted }}>· {r.complainant} vs {r.accused} · {r.status.replace("_", " ").toLowerCase()} · {r.minLevel ? `level ${r.minLevel}+` : "category level"} · {new Date(r.createdAt).toLocaleString()}</span>
+          </div>
+        ))}
+        <p style={{ margin: "12px 0 0" }}><a href="/admin">Open Complaints →</a></p>
+      </section>
+    </main>
+  );
+}
