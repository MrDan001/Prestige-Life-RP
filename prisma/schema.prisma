// PATH: prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// OWNER, TECH and DEVELOPER are the "top tier": equal full rights.
// ADMIN uses the numeric level 1-6 (6 = chief admin / deputy chief admin).
enum StaffKind {
  OWNER
  TECH
  DEVELOPER
  ADMIN
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum Verdict {
  COMPLAINANT
  ACCUSED
  INSUFFICIENT
}

enum EvidenceKind {
  IMAGE
  VIDEO
  LINK
  TEXT
}

model Admin {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  title        String    @default("Admin") // display only: Curator, Senior Admin, Chief Admin...
  passwordHash String?
  kind         StaffKind @default(ADMIN)
  level        Int       @default(1)
  extraRights  String[]  @default([]) // MANAGE_CATEGORIES, MANAGE_STAFF (owner grants)
  gameId       String?   @unique // links this staff member to their in-game account
  suspended    Boolean   @default(false) // suspended staff cannot sign in or use the site
  sessionsRevokedAt DateTime? // invalidates legacy and registered sessions issued before this time
  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())

  responses         Response[]
  complaintsAgainst Complaint[] @relation("Accused")
  audits            AuditLog[]
  claimedComplaints Complaint[] @relation("Claimed")
  notes             Note[]
  invitations       AdminInvitation[]
  sessions          AdminSession[]
}

model Category {
  id            String      @id @default(cuid())
  name          String      @unique
  minReplyLevel Int         @default(3)
  minCloseLevel Int         @default(3)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  complaints    Complaint[]
  templates     ResponseTemplate[]
}

model Player {
  id         String      @id @default(cuid())
  gameId     String      @unique
  username   String
  createdAt  DateTime    @default(now())
  complaints Complaint[]
}

model Complaint {
  id             String          @id @default(cuid())
  playerId       String
  player         Player          @relation(fields: [playerId], references: [id])
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id])
  accusedName    String?
  accusedGameId  String?
  accusedAdminId String?
  accusedAdmin   Admin?          @relation("Accused", fields: [accusedAdminId], references: [id])
  claimedById    String?
  claimedBy      Admin?          @relation("Claimed", fields: [claimedById], references: [id])
  claimedAt      DateTime?
  verdict        Verdict?
  message        String
  status         ComplaintStatus @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  responses      Response[]
  notes          Note[]
  evidence       Evidence[]

  @@index([status, createdAt])
}

model Response {
  id           String    @id @default(cuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id])
  adminId      String
  admin        Admin     @relation(fields: [adminId], references: [id])
  message      String
  syncedToGame Boolean   @default(false)
  templateId   String?
  template     ResponseTemplate? @relation(fields: [templateId], references: [id])
  createdAt    DateTime  @default(now())

  @@index([syncedToGame])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     Admin    @relation(fields: [actorId], references: [id])
  action    String
  targetId  String?
  detail    String
  createdAt DateTime @default(now())
}

// Short-lived code the GAME issues for an in-game account. Staff type it on the website
// to prove they own that game account (so nobody can claim someone else's game ID).
model LinkCode {
  id        String    @id @default(cuid())
  code      String    @unique
  gameId    String
  username  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([gameId])
}

// Internal staff notes on a complaint. Never sent to the game or the player.
model Note {
  id          String    @id @default(cuid())
  complaintId String
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  adminId     String
  admin       Admin     @relation(fields: [adminId], references: [id])
  message     String
  createdAt   DateTime  @default(now())

  @@index([complaintId])
}

// Reply template for a category. verdict = null means usable with any verdict.
model ResponseTemplate {
  id         String     @id @default(cuid())
  categoryId String?    // empty = usable on every category
  category   Category?  @relation(fields: [categoryId], references: [id])
  name       String
  verdict    Verdict?
  minLevel   Int        @default(3) // lowest admin level that may issue this judgment
  closesAs   ComplaintStatus? // RESOLVED or DISMISSED, applied when the judgment is sent
  sortOrder  Int        @default(0)
  body       String
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  responses  Response[]

  @@index([categoryId, active])
}

// Evidence created in the game and attached to a complaint.
model Evidence {
  id          String       @id @default(cuid())
  complaintId String
  complaint   Complaint    @relation(fields: [complaintId], references: [id])
  kind        EvidenceKind
  url         String?
  text        String?
  caption     String?
  createdAt   DateTime     @default(now())

  @@index([complaintId])
}

// One row (id "main") holding the public home page settings.
model SiteSetting {
  id           String   @id
  launchStatus String   @default("COMING_SOON") // COMING_SOON | LIVE | MAINTENANCE
  playStoreUrl String?
  appStoreUrl  String?
  apkUrl       String?
  apkVersion   String?
  discordUrl   String?
  statSlots    Int?
  statUptime   Int?
  statCitizens Int?
  updatedAt    DateTime @updatedAt
}

// A role is a title with rules about which levels it can sit on. Rights still come from the level
// (and top tier). Custom roles can also carry extra rights.
model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  kind        StaffKind @default(ADMIN) // OWNER / TECH / DEVELOPER are the top-tier roles
  minLevel    Int       @default(1)
  maxLevel    Int       @default(4)
  extraRights String[]  @default([])
  system      Boolean   @default(false) // built-in roles cannot be edited
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  admins      Admin[]
}


/// One-time, owner-issued invitation. Only a SHA-256 token hash is stored.
model AdminInvitation {
  id          String   @id @default(cuid())
  adminId     String
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime @default(now())

  @@index([adminId, expiresAt])
  @@index([expiresAt])
}

/// Server-side session registry allows immediate revocation of already-issued cookies.
model AdminSession {
  id        String   @id
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([adminId, revokedAt])
  @@index([expiresAt])
}
